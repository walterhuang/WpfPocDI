<Window x:Class="WpfApp4.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">

            <TextBlock Text="Sign In"
                       FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <TextBlock Text="Username" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" Margin="0,0,0,12"/>

            <TextBlock Text="Password" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         Padding="6,4" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <Button Content="Login"
                    Command="{Binding LoginCommand}"
                    Padding="0,8"
                    FontSize="14"/>

        </StackPanel>
    </Grid>
</Window>
